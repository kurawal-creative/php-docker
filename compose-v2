services:
  # 1. Laravel (Apache + PHP-FPM)
  app:
    image: shinsenter/php:8.4-fpm-apache
    working_dir: /var/www/html
    volumes:
      - .:/var/www/html
    ports:
      - "80:80"
      - "443:443"
    environment:
      - DOCUMENT_ROOT=/var/www/html/public
      - APP_UID=1000
      - APP_GID=1000

  # 2. Database MariaDB
  db:
    image: yobasystems/alpine-mariadb:10.6
    environment:
      MYSQL_ROOT_PASSWORD: root
    ports:
      - "3306:3306"
    volumes:
      - mariadb_data:/var/lib/mysql
    command: --sql-mode="STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION,ONLY_FULL_GROUP_BY"

  # 3. phpMyAdmin
  phpmyadmin:
    image: phpmyadmin:5
    container_name: laravel_pma
    environment:
      PMA_HOST: db
      MYSQL_ROOT_PASSWORD: root
    ports:
      - "81:80"
    depends_on:
      - db

  # 4. Vite (Node.js untuk Frontend HMR)
  # vite:
  #   image: node:24-alpine
  #   user: "1000:1000"
  #   ports:
  #     - "5173:5173"
  #   command: sh -c "npm install && npm run dev"

volumes:
  mariadb_data:
